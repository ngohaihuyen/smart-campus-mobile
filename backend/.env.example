# Copy this file to .env and fill in your own values
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_campus

# Any long random string. Never commit the real .env to GitHub
JWT_SECRET=change_me_to_a_long_random_string
# Access token lifetime in seconds (returned to the app as "expiresIn"). 3600 = 1 hour
JWT_EXPIRES_IN_SECONDS=3600

# Booking rules, campus time (Asia/Ho_Chi_Minh)
OPENING_TIME=07:00
CLOSING_TIME=21:00
MAX_BOOKING_MINUTES=120

# Only accept school accounts (workflow "Có phải tài khoản của trường?").
# Comma-separated domains, e.g. university.edu.vn,st.university.edu.vn
# Leave empty to allow any domain (seed accounts use example.test)
ALLOWED_EMAIL_DOMAINS=
